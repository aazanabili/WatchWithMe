NODE_ENV=development
ALLOW_INSECURE_LOCAL_MEDIA=true
REALTIME_PORT=4000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
DATABASE_URL="postgresql://watch_with_me:watch_with_me_dev@localhost:5432/watch_with_me"
REDIS_URL=redis://localhost:6379
REALTIME_ROOM_REPOSITORY=prisma
REALTIME_ORIGINS=http://localhost:3000
REALTIME_MAX_PAYLOAD=32kb
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media
MINIO_USE_SSL=false
MINIO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MINIO_PUBLIC_ORIGIN=http://localhost:9000
MEDIA_MAX_BYTES=10000000000
MEDIA_JOB_TIMEOUT_MS=900000
LIVEKIT_API_KEY=dev-watch-with-me-key-32-characters
LIVEKIT_API_SECRET=dev-watch-with-me-secret-32-chars-long
LIVEKIT_URL=ws://localhost:7880
# Docker defaults to relay-only ICE through embedded TURN; set false for direct ICE outside Docker.
NEXT_PUBLIC_LIVEKIT_RELAY_ONLY=true
TURN_SHARED_SECRET=replace-with-a-long-random-secret
TURN_REALM=watch-with-me.local
TURN_URL=turn:localhost:3478?transport=tcp
# Docker ICE endpoints use the fixed backend subnet; no LAN node IP is required.
